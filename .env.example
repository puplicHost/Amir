# Copy to `.env` for local development.
# Inside Docker Compose the `app` service overrides DATABASE_URL to use the `db` host.
# Port must match docker-compose.yml db mapping ("5439:5432").
DATABASE_URL="postgresql://amir:amir@localhost:5439/amir?schema=public"

# Session encryption secret (Phase 2 auth, min 32 chars). Generate with: openssl rand -base64 32
# Maps to runtimeConfig.sessionPassword (server-only).
NUXT_SESSION_PASSWORD="change-me-in-production-min-32-chars"

# Encryption key for payment credentials (Phase 4, 32 bytes in hex = 64 hex chars).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Initial super-admin seed credentials.
# Set strong values in your local .env only — never reuse a documented default.
# Generate one with: openssl rand -base64 24
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me-please-use-a-strong-unique-password"

# Firebase Cloud Messaging (Admin push notifications).
# Server SDK credentials — never commit real values. The app runs with push
# disabled (graceful) when these are unset.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Web push config (public keys, safe to expose to the browser).
FIREBASE_VAPID_KEY=
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NUXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NUXT_PUBLIC_FIREBASE_APP_ID=

# Canonical public site URL (no trailing slash). Used for Conversions API
# event_source_url, share links and domain verification. Must use https:// in
# production; the server refuses to start in production when it is missing.
NUXT_PUBLIC_SITE_URL=

# Meta Test Events are blocked in production unless this is explicitly "true".
# A configured Test Event Code suppresses server delivery instead of becoming
# a real conversion. Leave false/empty for normal production tracking.
META_CAPI_ALLOW_TEST_EVENTS=false

# ── Stripe Checkout (TEST MODE ONLY) ─────────────────────────────────────────
# Server-side secret key from the Stripe Dashboard (Sandbox/test mode), sk_test_...
# Live keys (sk_live_...) are rejected unless STRIPE_ALLOW_LIVE=true.
STRIPE_SECRET_KEY=
# Publishable key (pk_test_...). Optional for hosted Checkout (server-side
# session creation); used for admin display and future Stripe Elements.
STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) for /api/webhooks/stripe.
STRIPE_WEBHOOK_SECRET=
# Leave false/empty for Sandbox-only. Setting true permits sk_live_ keys.
STRIPE_ALLOW_LIVE=false

# Launch Mode: false = Development mode (EN default + DE with language toggle).
# true = Production launch mode (German only, no prefix, toggle hidden).
NUXT_PUBLIC_LAUNCH_MODE=false

NODE_ENV="development"

# Server bind (used by docker-compose.yml app service).
NITRO_PORT="3000"
NITRO_HOST="0.0.0.0"
