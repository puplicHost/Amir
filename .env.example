# Copy to `.env` for local development.
# Inside Docker Compose the `app` service overrides DATABASE_URL to use the `db` host.
DATABASE_URL="postgresql://mango:mango@localhost:5432/mango?schema=public"

# Session encryption secret (Phase 2 auth). Generate with: openssl rand -base64 32
NUXT_SESSION_SECRET="change-me-in-production"

NODE_ENV="development"
