// Phase 2: complete domain schema. Phases 3-6 use these models
// without introducing new ones unless explicitly required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Admin & RBAC ──────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  title        String?
  salary       Decimal? @db.Decimal(10, 2)
  phone        String?
  isSuper      Boolean  @default(false)
  isActive     Boolean  @default(true)
  role         String   @default("STAFF") // 'ADMIN' | 'MANAGER' | 'STAFF' (Phase 2e; isSuper bypasses role checks)
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions   AdminPermission[]
  deviceTokens  AdminDeviceToken[]
  notifications AdminNotification[]

  // Salon bookings assigned to this staff member.
  assignedBookings Booking[]           @relation("BookingAssignee")
  staffAssignments BookingAssignment[]
}

model AdminPermission {
  id         String @id @default(cuid())
  userId     String
  permission String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

// ─── Catalog ───────────────────────────────────────────────────

model Category {
  id                 String   @id @default(cuid())
  nameAr             String
  nameEn             String
  slug               String   @unique
  descriptionAr      String?  @db.Text
  descriptionEn      String?  @db.Text
  coverImagePath     String?
  coverVideoUrl      String?
  featuredOnHomepage Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products Product[]

  @@index([featuredOnHomepage])
}

model Product {
  id             String   @id @default(cuid())
  nameAr         String
  nameEn         String
  slug           String   @unique
  descriptionAr  String?  @db.Text
  descriptionEn  String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  categoryId     String
  brand          String? // free text (Phase 2a)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  attributes ProductAttribute[]
  seo        ProductSeo?
  video      ProductVideo?
  documents  ProductDocument[]

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([nameAr])
  @@index([nameEn])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String
  altAr     String?
  altEn     String?
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  keyAr     String
  keyEn     String
  valueAr   String
  valueEn   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSeo {
  id                String  @id @default(cuid())
  productId         String  @unique
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String? @db.Text
  metaDescriptionEn String? @db.Text
  keywords          String?
  geoContent        String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String   @id @default(cuid())
  productId String   @unique
  type      String   // 'youtube' | 'vimeo' | 'upload'
  url       String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  labelAr   String
  labelEn   String
  filePath  String
  fileType  String   @default("pdf")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Services & salon bookings ───────────────────────────────
// All timestamps stored in UTC; Europe/Berlin conversion happens at the edges.

enum ServiceSection {
  DAMEN
  HERREN
  KINDER
  KOSMETIK
}

model Service {
  id                  String         @id @default(cuid())
  slug                String         @unique
  section             ServiceSection
  name                String // German only
  description         String?        @db.Text // German only
  priceAbCents        Int // listed "ab" price in EUR cents
  durationMin         Int            @default(30)
  needsDurationReview Boolean        @default(true)
  isActive            Boolean        @default(true)
  featuredOnHomepage  Boolean        @default(false)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bookings Booking[]

  @@index([section, isActive, sortOrder])
  @@index([featuredOnHomepage])
}

model WorkingHours {
  id       String  @id @default(cuid())
  weekday  Int // 0=Sunday … 6=Saturday (JS getDay convention), salon-local Europe/Berlin
  openMin  Int // minutes since midnight, salon-local
  closeMin Int // minutes since midnight, salon-local
  isClosed Boolean @default(false)

  @@unique([weekday])
}

model Booking {
  id                  String    @id @default(cuid())
  bookingNumber       String    @unique
  serviceId           String
  customerName        String
  customerPhone       String
  customerEmail       String?
  startsAt            DateTime // UTC
  durationMinSnapshot Int
  priceSnapshotCents  Int
  depositCents        Int // 50% of price snapshot, rounded half-up to cents
  paymentProvider     String // 'stripe' | 'paypal'
  paymentStatus       String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  providerRef         String?   @unique
  idempotencyKey      String    @unique
  publicToken         String    @unique // unguessable public lookup key (success/failed pages)
  status              String    @default("UNASSIGNED") // UNASSIGNED | ASSIGNED | CANCELLED_BY_STAFF | COMPLETED
  assignedStaffId     String?
  notes               String?   @db.Text
  holdExpiresAt       DateTime? // PENDING bookings hold the slot until this UTC instant
  needsRefund         Boolean   @default(false) // verified money that could not be honored: admin attention, manual refund (no auto-refunds)
  marketingConsent    Boolean   @default(false) // Phase 2f: user granted marketing cookie consent
  fbp                 String? // Meta browser cookie _fbp (read only when marketing consent is true)
  fbc                 String? // Meta click cookie _fbc (read only when marketing consent is true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedStaff AdminUser?          @relation("BookingAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignments   BookingAssignment[]

  @@index([serviceId, startsAt])
  @@index([assignedStaffId, startsAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([holdExpiresAt])
}

model BookingAssignment {
  id           String    @id @default(cuid())
  bookingId    String
  staffId      String
  assignedById String // AdminUser id (no FK: history survives user deletion)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?   @db.Text

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   AdminUser @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([staffId])
}

// ─── Admin push notifications & notification center ────────────

model AdminDeviceToken {
  id          String   @id @default(cuid())
  adminUserId String
  fcmToken    String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminNotification {
  id              String   @id @default(cuid())
  adminUserId     String
  type            String // 'new_service_request' | 'payment_needs_refund' | 'new_staff_user' | 'staff_updated' | 'failed_logins'
  titleEn         String
  titleAr         String
  bodyEn          String
  bodyAr          String
  relatedEntityId String?
  url             String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, isRead])
  @@index([adminUserId, createdAt])
}

// ─── Homepage banners ──────────────────────────────────────────

model Banner {
  id                  String   @id @default(cuid())
  titleAr             String
  titleEn             String
  descriptionAr       String?  @db.Text
  descriptionEn       String?  @db.Text
  backgroundImagePath String?
  buttonTextAr        String?
  buttonTextEn        String?
  buttonLinkType      String?
  buttonLinkValue     String?
  placement           String   @default("below_services")
  widthPercent        Int      @default(100)
  backgroundColor     String?
  textColor           String?
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([placement, isActive, sortOrder])
}

// ─── Top announcement carousel items ───────────────────────────

model AnnouncementItem {
  id        String   @id @default(cuid())
  textAr    String
  textEn    String?
  type      String   @default("general") // 'product' | 'service' | 'general'
  linkType  String   @default("none") // 'product' | 'service' | 'url' | 'none'
  linkValue String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Site settings (singleton, id = 1) ─────────────────────────

model SiteSettings {
  id Int @id @default(autoincrement())

  siteNameAr String  @default("أمير")
  siteNameEn String  @default("Amir")
  taglineAr  String? @db.Text
  taglineEn  String? @db.Text
  logoPath   String?
  faviconPath String?
  heroImagePath String?

  primaryDarkColor String @default("#1C2940")
  primaryColor     String @default("#1C2940")
  accentColor      String @default("#F5CC07")

  offerEndDate       DateTime?
  announcementActive Boolean   @default(true)
  announcementBgColor String   @default("#1C2940")

  bannerTextAr       String? @db.Text
  bannerTextEn       String? @db.Text
  bannerButtonTextAr String?
  bannerButtonTextEn String?
  bannerButtonUrl    String?

  contactPhone1     String?
  contactPhone2     String?
  contactWhatsapp   String?
  contactEmail      String?
  contactAddressAr  String? @db.Text
  contactAddressEn  String? @db.Text
  socialFacebook    String?
  socialInstagram   String?
  socialTiktok      String?
  socialYoutube     String?
  socialLinkedin    String?
  socialX           String?
  googleMapsEmbedUrl String? @db.Text

  seoMetaTitleTemplateAr String?
  seoMetaTitleTemplateEn String?
  seoMetaDescriptionAr   String? @db.Text
  seoMetaDescriptionEn   String? @db.Text
  seoKeywords            String?
  geoDescription         String? @db.Text

  defaultCurrency String @default("EUR")
  productsPerPage Int    @default(16)

  tickerTextAr String? @db.Text
  tickerTextEn String? @db.Text
  tickerActive Boolean @default(false)
  tickerSpeed  Int     @default(30)

  // Meta (Facebook) Pixel + Conversions API — access token stored AES-256-GCM
  // encrypted. Never returned raw.
  metaPixelId      String?
  metaCapiToken    String? @db.Text
  metaTestEventCode String?
  metaEnabled      Boolean @default(false)

  // ── Salon booking settings (Phase 2a) ──
  // Gateway secrets are AES-256-GCM encrypted via server/utils/encryption.ts.
  // Admin GET endpoints expose only hasCredentials booleans, never raw secrets.
  stripeEnabled        Boolean @default(false)
  stripePublishableKey String?
  stripeSecretKey      String? @db.Text
  stripeWebhookSecret  String? @db.Text
  paypalEnabled        Boolean @default(false)
  paypalClientId       String?
  paypalSecret         String? @db.Text
  paypalWebhookId      String? @db.Text
  paypalMode           String  @default("sandbox") // 'sandbox' | 'live'

  whatsappNumber String?
  businessName   String?
  businessAddress String? @db.Text

  slotStepMin    Int    @default(15) // slot grid step in minutes
  holdTtlMin     Int    @default(20) // PENDING payment hold TTL in minutes
  depositPercent Int    @default(50)
  timezone       String @default("Europe/Berlin")

  updatedAt DateTime @updatedAt
}

// ─── Audit Log (who created / edited products, categories, services) ──

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // 'product' | 'category' | 'service'
  entityId   String
  entityName String
  action     String // 'created' | 'updated' | 'deleted' | 'media'
  details    String?  @db.Text
  userId     String?
  userName   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Contact inbox ─────────────────────────────────────────────
// Public contact-form messages. Read/deleted from Admin → Inbox.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}
