// Phase 2: complete domain schema. Phases 3-6 use these models
// without introducing new ones unless explicitly required.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Admin & RBAC ──────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  title        String?
  salary       Decimal? @db.Decimal(10, 2)
  phone        String?
  isSuper      Boolean  @default(false)
  isActive     Boolean  @default(true)
  role         String   @default("STAFF") // 'ADMIN' | 'MANAGER' | 'STAFF' (Phase 2e; isSuper bypasses role checks)
  lastLoginAt  DateTime?
  // AUDIT P2-07: persisted brute-force lockout. Reset on successful login.
  failedLoginCount Int      @default(0)
  lockedUntil      DateTime?
  // AUDIT P2-07/P2-08: password rotation timestamp and revocable sessions.
  passwordChangedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions   AdminPermission[]
  sessions      AdminSession[]
  deviceTokens  AdminDeviceToken[]
  notifications AdminNotification[]

  // Salon bookings assigned to this staff member.
  assignedBookings Booking[]           @relation("BookingAssignee")
  staffAssignments BookingAssignment[]
  staffProfile     StaffProfile?
  staffServices    StaffService[]
  staffSchedules   StaffSchedule[]
  staffTimeOffs    StaffTimeOff[]
}

model AdminPermission {
  id         String @id @default(cuid())
  userId     String
  permission String

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, permission])
  @@index([userId])
}

// AUDIT P2-08: server-side session registry. The sealed cookie carries a random
// token; only its SHA-256 hash is stored here. Logging out, changing a password,
// or deactivating an account revokes rows immediately.
model AdminSession {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  ip         String?
  userAgent  String?  @db.Text
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

// ─── Catalog ───────────────────────────────────────────────────

model Category {
  id                 String   @id @default(cuid())
  nameAr             String
  nameEn             String
  // AUDIT P2-11: optional German catalog copy. Null means fall back to nameEn;
  // existing rows stay valid without a destructive backfill.
  nameDe             String?
  slug               String   @unique
  descriptionAr      String?  @db.Text
  descriptionEn      String?  @db.Text
  descriptionDe      String?  @db.Text
  coverImagePath     String?
  coverVideoUrl      String?
  featuredOnHomepage Boolean  @default(false)
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  products Product[]

  @@index([featuredOnHomepage])
}

model Product {
  id             String   @id @default(cuid())
  nameAr         String
  nameEn         String
  // AUDIT P2-11: optional German catalog copy. Null means fall back to nameEn.
  nameDe         String?
  slug           String   @unique
  descriptionAr  String?  @db.Text
  descriptionEn  String?  @db.Text
  descriptionDe  String?  @db.Text
  price          Decimal  @db.Decimal(10, 2)
  categoryId     String
  brand          String? // free text (Phase 2a)
  isActive       Boolean  @default(true)
  featuredOnHomepage Boolean @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category   Category           @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images     ProductImage[]
  attributes ProductAttribute[]
  seo        ProductSeo?
  video      ProductVideo?
  documents  ProductDocument[]

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([nameAr])
  @@index([nameEn])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  path      String
  altAr     String?
  altEn     String?
  sortOrder Int     @default(0)
  isCover   Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductAttribute {
  id        String @id @default(cuid())
  productId String
  keyAr     String
  keyEn     String
  valueAr   String
  valueEn   String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductSeo {
  id                String  @id @default(cuid())
  productId         String  @unique
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String? @db.Text
  metaDescriptionEn String? @db.Text
  keywords          String?
  geoContent        String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductVideo {
  id        String   @id @default(cuid())
  productId String   @unique
  type      String   // 'youtube' | 'vimeo' | 'upload'
  url       String
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model ProductDocument {
  id        String   @id @default(cuid())
  productId String
  labelAr   String
  labelEn   String
  filePath  String
  fileType  String   @default("pdf")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

// ─── Services & salon bookings ───────────────────────────────
// All timestamps stored in UTC; Europe/Berlin conversion happens at the edges.

enum ServiceSection {
  DAMEN
  HERREN
  KINDER
  KOSMETIK
}

model Service {
  id                  String         @id @default(cuid())
  slug                String         @unique
  section             ServiceSection
  name                String // German (canonical)
  description         String?        @db.Text // German (canonical)
  // AUDIT P2-11/P3-13: optional English copy. Null means "use German".
  nameEn              String?
  descriptionEn       String?        @db.Text
  coverImagePath      String?
  priceAbCents        Int // listed "ab" price in EUR cents
  durationMin         Int            @default(30)
  needsDurationReview Boolean        @default(true)
  isActive            Boolean        @default(true)
  featuredOnHomepage  Boolean        @default(false)
  sortOrder           Int            @default(0)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  bookings Booking[]
  staffServices StaffService[]

  @@index([section, isActive, sortOrder])
  @@index([featuredOnHomepage])
}

model WorkingHours {
  id       String  @id @default(cuid())
  weekday  Int // 0=Sunday … 6=Saturday (JS getDay convention), salon-local Europe/Berlin
  openMin  Int // minutes since midnight, salon-local
  closeMin Int // minutes since midnight, salon-local
  isClosed Boolean @default(false)
  // AUDIT P1-03: optimistic-concurrency revision for the admin schedule editor.
  updatedAt DateTime @updatedAt

  @@unique([weekday])
}

model Booking {
  id                  String    @id @default(cuid())
  bookingNumber       String    @unique
  serviceId           String
  customerName        String
  customerPhone       String
  customerEmail       String?
  startsAt            DateTime // UTC
  durationMinSnapshot Int
  priceSnapshotCents  Int
  depositCents        Int // 50% of price snapshot, rounded half-up to cents
  paymentProvider     String // 'stripe' | 'paypal'
  paymentStatus       String    @default("PENDING") // PENDING | PAID | FAILED | EXPIRED
  providerRef         String?   @unique
  idempotencyKey      String    @unique
  publicToken         String    @unique // unguessable public lookup key (success/failed pages)
  status              String    @default("UNASSIGNED") // UNASSIGNED | ASSIGNED | COMPLETED; cancellations set CANCELLED + cancelledAt (CANCELLED_BY_STAFF is legacy-only, never written)
  staffChoice         String    @default("ANY") // SPECIFIC | ANY (Roadmap Phase 4)
  source              String    @default("ONLINE") // ONLINE | WALK_IN | WHATSAPP | PHONE (Roadmap Phase 5)
  locale              String    @default("de") // customer message language de|en (Roadmap Phase 7)
  manageToken         String?   @unique // unguessable self-service key for /booking/manage (Roadmap Phase 7/8)
  providerPaymentId   String? // Stripe payment_intent or PayPal capture id for refunds (Roadmap Phase 8)
  cancelledAt         DateTime?
  cancelledBy         String? // CUSTOMER | ADMIN | STAFF | SYSTEM (Roadmap Phase 8)
  cancellationReason  String?   @db.Text
  refundStatus        String    @default("NONE") // NONE | PENDING | SUCCEEDED | FAILED | OUTSIDE (Roadmap Phase 8)
  whatsappReminder    Boolean   @default(false) // customer opted into WhatsApp reminders (Roadmap Phase 9)
  assignedStaffId     String?
  notes               String?   @db.Text
  holdExpiresAt       DateTime? // PENDING bookings hold the slot until this UTC instant
  needsRefund         Boolean   @default(false) // verified money that could not be honored: admin attention, manual refund (no auto-refunds)
  marketingConsent    Boolean   @default(false) // Phase 2f: user granted marketing cookie consent
  // AUDIT P1-01: immutable consent evidence captured server-side at booking time.
  termsAcceptedAt     DateTime?
  termsVersion        String?
  privacyAcceptedAt   DateTime?
  privacyVersion      String?
  marketingConsentAt  DateTime?
  marketingConsentVersion String?
  fbp                 String? // Meta browser cookie _fbp (read only when marketing consent is true)
  fbc                 String? // Meta click cookie _fbc (read only when marketing consent is true)
  // AUDIT P2-13: network signals for server-side Meta events. Captured at
  // booking time ONLY when the customer granted marketing consent.
  metaClientIp        String?
  metaClientUa        String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  service       Service             @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  assignedStaff AdminUser?          @relation("BookingAssignee", fields: [assignedStaffId], references: [id], onDelete: SetNull)
  assignments   BookingAssignment[]
  outbox        NotificationOutbox[]
  refunds       BookingRefund[]

  @@index([serviceId, startsAt])
  @@index([assignedStaffId, startsAt])
  // DB-01/DB-02: bare startsAt-range scans (availability/confirm/assign) and
  // the sweeper's (paymentStatus, holdExpiresAt) lookups.
  @@index([startsAt])
  @@index([status, startsAt])
  @@index([paymentStatus, holdExpiresAt])
  @@index([paymentStatus])
  @@index([status])
  @@index([holdExpiresAt])
}

model BookingAssignment {
  id           String    @id @default(cuid())
  bookingId    String
  staffId      String
  assignedById String // AdminUser id (no FK: history survives user deletion)
  assignedAt   DateTime  @default(now())
  unassignedAt DateTime?
  reason       String?   @db.Text

  booking Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  staff   AdminUser @relation(fields: [staffId], references: [id], onDelete: Restrict)

  @@index([bookingId])
  @@index([staffId])
}

// ─── Staff booking (Roadmap Phase 4) ─────────────────────────
// Staff are AdminUsers with role STAFF. StaffProfile is a 1-1 extension
// holding public booking data. Empty StaffService rows = all services.
// Empty StaffSchedule rows for a weekday = inherit from WorkingHours.

model StaffProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  displayName String
  imagePath   String?
  isBookable  Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([isBookable, sortOrder])
}

model StaffService {
  id        String   @id @default(cuid())
  staffId   String
  serviceId String
  createdAt DateTime @default(now())

  staff   AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)
  service Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([staffId, serviceId])
  @@index([serviceId])
  @@index([staffId])
}

model StaffSchedule {
  id       String  @id @default(cuid())
  staffId  String
  weekday  Int // 0=Sunday … 6=Saturday (JS getDay convention), salon-local Europe/Berlin
  openMin  Int // minutes since midnight, salon-local
  closeMin Int // minutes since midnight, salon-local
  isClosed Boolean @default(false)

  staff AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, weekday])
  @@index([staffId])
}

model StaffTimeOff {
  id        String   @id @default(cuid())
  staffId   String
  startsAt  DateTime // UTC
  endsAt    DateTime // UTC
  reason    String?  @db.Text
  createdBy String? // AdminUser id (no FK: history survives user deletion)
  createdAt DateTime @default(now())

  staff AdminUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId, startsAt, endsAt])
  @@index([startsAt, endsAt])
}

model SalonClosure {
  id        String   @id @default(cuid())
  day       String   @unique // YYYY-MM-DD, salon-local Europe/Berlin
  reason    String?  @db.Text
  createdAt DateTime @default(now())

  @@index([day])
}

// ─── Customer mail outbox (Roadmap Phase 7) ────────────────────
// Dedupe: one row per dedupeKey — webhook replays and parallel sweepers
// can never send the same message twice. Failure never fails a booking.

model NotificationOutbox {
  id        String   @id @default(cuid())
  bookingId String?
  type      String // booking_confirmed | booking_changed | booking_cancelled | refund_confirmed | reminder
  channel   String   @default("EMAIL")
  locale    String   @default("de")
  sendTo    String
  subject   String
  bodyText  String   @db.Text
  bodyHtml  String?  @db.Text
  ical      String?  @db.Text
  status    String   @default("PENDING") // PENDING | SENDING | SENT | SIMULATED | FAILED | SKIPPED
  provider  String? // provider used for the last delivery attempt
  acceptedAt DateTime? // provider accepted the message (never set for simulated/log)
  simulated Boolean  @default(false) // log-provider preview: never counts as delivered
  attempts  Int      @default(0)
  lastError String?  @db.Text
  dedupeKey String   @unique
  sendAfter DateTime @default(now())
  sentAt    DateTime?
  createdAt DateTime @default(now())

  booking Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status, sendAfter])
  @@index([bookingId])
}

// ─── Booking refunds (Roadmap Phase 8) ─────────────────────────
// Real refunds via Stripe/PayPal APIs with idempotency keys. Webhook
// replays resolve by provider reference and never double-refund.

model BookingRefund {
  id             String   @id @default(cuid())
  bookingId      String
  amountCents    Int
  reason         String?  @db.Text
  status         String   @default("PENDING") // PENDING | SUCCEEDED | FAILED
  provider       String // stripe | paypal | manual
  providerRef    String?
  idempotencyKey String   @unique
  initiatedBy    String?
  createdAt      DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([status])
}

// ─── Salon expenses (Roadmap Phase 10) ─────────────────────────
// Standalone expense tracking with Excel-friendly CSV export. Soft delete +
// audit trail. Revenue/profit accounting is explicitly out of scope.

model ExpenseCategory {
  id        String   @id @default(cuid())
  nameDe    String
  nameEn    String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses Expense[]

  @@index([isActive, sortOrder])
}

model Expense {
  id          String    @id @default(cuid())
  day         String // YYYY-MM-DD, salon-local Europe/Berlin
  categoryId  String
  amountCents Int
  description String?   @db.Text
  vendor      String?
  payMethod   String    @default("cash") // cash | card | transfer | other
  taxPercent  Int?
  receiptPath String?
  createdBy   String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([day])
  @@index([categoryId])
  @@index([deletedAt, day])
}

// ─── Admin push notifications & notification center ────────────

model AdminDeviceToken {
  id          String   @id @default(cuid())
  adminUserId String
  fcmToken    String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminNotification {
  id              String   @id @default(cuid())
  adminUserId     String
  type            String // 'new_service_request' | 'payment_needs_refund' | 'new_staff_user' | 'staff_updated' | 'failed_logins'
  titleEn         String
  titleAr         String
  bodyEn          String
  bodyAr          String
  relatedEntityId String?
  url             String?
  isRead          Boolean  @default(false)
  createdAt       DateTime @default(now())

  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, isRead])
  @@index([adminUserId, createdAt])
}

// ─── Homepage banners ──────────────────────────────────────────

model Banner {
  id                  String   @id @default(cuid())
  titleAr             String
  titleEn             String
  descriptionAr       String?  @db.Text
  descriptionEn       String?  @db.Text
  backgroundImagePath String?
  buttonTextAr        String?
  buttonTextEn        String?
  buttonLinkType      String?
  buttonLinkValue     String?
  placement           String   @default("below_services")
  widthPercent        Int      @default(100)
  backgroundColor     String?
  textColor           String?
  isActive            Boolean  @default(true)
  sortOrder           Int      @default(0)
  createdAt           DateTime @default(now())

  @@index([placement, isActive, sortOrder])
}

// ─── Homepage hero slideshow ───────────────────────────────
// Multiple managed images shown as an automatic slideshow on the home page.
// The legacy SiteSettings.heroImagePath column is left untouched.

model HeroSlide {
  id         String   @id @default(cuid())
  imagePath  String
  altText    String?
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Top announcement carousel items ───────────────────────────

model AnnouncementItem {
  id        String   @id @default(cuid())
  textAr    String
  textEn    String?
  type      String   @default("general") // 'product' | 'service' | 'general'
  linkType  String   @default("none") // 'product' | 'service' | 'url' | 'none'
  linkValue String?
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// ─── Site settings (singleton, id = 1) ─────────────────────────

model SiteSettings {
  id Int @id @default(autoincrement())
  // AUDIT P2-15: unique singleton marker. Exactly one row may have true;
  // historical duplicate rows are normalized to NULL by the migration.
  singleton Boolean? @unique @default(true)

  siteNameAr String  @default("أمير")
  siteNameEn String  @default("Amir")
  taglineAr  String? @db.Text
  taglineEn  String? @db.Text
  logoPath   String?
  faviconPath String?
  heroImagePath String?
  heroSlideIntervalSec Int @default(6)

  primaryDarkColor String @default("#1C2940")
  primaryColor     String @default("#1C2940")
  accentColor      String @default("#F5CC07")

  offerEndDate       DateTime?
  announcementActive Boolean   @default(true)
  announcementBgColor String   @default("#1C2940")

  bannerTextAr       String? @db.Text
  bannerTextEn       String? @db.Text
  bannerButtonTextAr String?
  bannerButtonTextEn String?
  bannerButtonUrl    String?

  contactPhone1     String?
  contactPhone2     String?
  contactWhatsapp   String?
  contactEmail      String?
  contactAddressAr  String? @db.Text
  contactAddressEn  String? @db.Text
  socialFacebook    String?
  socialInstagram   String?
  socialTiktok      String?
  socialYoutube     String?
  socialLinkedin    String?
  socialX           String?
  googleMapsEmbedUrl String? @db.Text

  seoMetaTitleTemplateAr String?
  seoMetaTitleTemplateEn String?
  seoMetaDescriptionAr   String? @db.Text
  seoMetaDescriptionEn   String? @db.Text
  seoKeywords            String?
  geoDescription         String? @db.Text

  defaultCurrency String @default("EUR")
  productsPerPage Int    @default(16)

  tickerTextAr String? @db.Text
  tickerTextEn String? @db.Text
  tickerActive Boolean @default(false)
  tickerSpeed  Int     @default(30)

  // Meta (Facebook) Pixel + Conversions API — access token stored AES-256-GCM
  // encrypted. Never returned raw.
  metaPixelId      String?
  metaCapiToken    String? @db.Text
  metaTestEventCode String?
  metaEnabled      Boolean @default(false)

  // ── Salon booking settings (Phase 2a) ──
  // Gateway secrets are AES-256-GCM encrypted via server/utils/encryption.ts.
  // Admin GET endpoints expose only hasCredentials booleans, never raw secrets.
  stripeEnabled        Boolean @default(false)
  stripePublishableKey String?
  stripeSecretKey      String? @db.Text
  stripeWebhookSecret  String? @db.Text
  paypalEnabled        Boolean @default(false)
  paypalClientId       String?
  paypalSecret         String? @db.Text
  paypalWebhookId      String? @db.Text
  paypalMode           String  @default("sandbox") // 'sandbox' | 'live'

  whatsappNumber String?
  businessName   String?
  businessAddress String? @db.Text

  slotStepMin    Int    @default(15) // slot grid step in minutes
  holdTtlMin     Int    @default(20) // PENDING payment hold TTL in minutes
  depositPercent Int    @default(50)
  timezone       String @default("Europe/Berlin")
  bookingMinLeadMin Int @default(120) // min minutes before start for online booking (Roadmap Phase 4, Q8)
  manualHoldTtlMin Int @default(1440) // PENDING hold TTL for manual/pay-link bookings in minutes (Roadmap Phase 5)
  reassignmentWaDe String? @db.Text // WhatsApp template for customer staff-change notice, German (Roadmap Phase 6)
  reassignmentWaEn String? @db.Text // WhatsApp template for customer staff-change notice, English (Roadmap Phase 6)

  // ── Customer mail (Roadmap Phase 7) ──
  // mailProvider: 'log' (server log, default) | 'http' (generic JSON API via fetch).
  // The HTTP key is AES-256-GCM encrypted; never returned raw.
  mailProvider     String  @default("log")
  mailFrom         String?
  mailFromName     String?
  mailHttpEndpoint String?
  mailHttpKey      String? @db.Text

  cancellationWindowHours Int @default(24) // self-cancel cutoff before start (Roadmap Phase 8)

  reminderLeadMin     Int     @default(60) // minutes before start for the customer reminder (Roadmap Phase 9)
  reminderEmailEnabled Boolean @default(true) // automatic reminder mails on/off (Roadmap Phase 9)

  updatedAt DateTime @updatedAt
}

// ─── Audit Log (who created / edited products, categories, services) ──

model AuditLog {
  id         String   @id @default(cuid())
  entityType String // 'product' | 'category' | 'service'
  entityId   String
  entityName String
  action     String // 'created' | 'updated' | 'deleted' | 'media'
  details    String?  @db.Text
  userId     String?
  userName   String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// ─── Contact inbox ─────────────────────────────────────────────
// Public contact-form messages. Read/deleted from Admin → Inbox.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  phone     String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead, createdAt])
}

// ─── Shared rate limiting (AUDIT P2-09) ────────────────────────
// Fixed-window counters shared across Nitro processes. Rows are short-lived
// and pruned opportunistically by the rate-limit utility.
model RateLimitBucket {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
